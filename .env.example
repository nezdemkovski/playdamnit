# Postgres (docker-compose builds POSTGRES_URL from these; host is the compose service "postgres")
POSTGRES_USER=playdamnit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=playdamnit
# For running the backend outside docker-compose
POSTGRES_URL=postgresql://playdamnit:change-me@localhost:5432/playdamnit

# Required in production
BETTER_AUTH_SECRET=
RESEND_API_KEY=

# CORS / Better Auth trusted origins, comma separated
TRUSTED_ORIGINS=https://playdamnit.com

# Honour X-Forwarded-For for rate limiting (only behind a trusted reverse proxy)
TRUST_PROXY=false

# Sentry Configuration
SENTRY_DSN=

# Log Level (error|warn|info|debug|silly|system)
LOG_LEVEL=error

# AI chat (disabled with 503 when unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Librarian (IGDB access)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# How many similar-games hops from a user request the catalog may grow
SIMILAR_GAMES_MAX_DEPTH=1
