# Used by docker-compose.yml (production-like stack). For local development see
# apps/api/.env.example, apps/librarian/.env.example and apps/web/.env.local.example.

# Postgres
POSTGRES_USER=playdamnit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=playdamnit

# API — required
BETTER_AUTH_SECRET=
RESEND_API_KEY=
# CORS / Better Auth trusted origins, comma separated
TRUSTED_ORIGINS=http://localhost:3000
# Honour X-Forwarded-For for rate limiting (only behind a trusted reverse proxy)
TRUST_PROXY=false
# AI chat (disabled with 503 when unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
SENTRY_DSN=
LOG_LEVEL=error

# Librarian (IGDB access) — required
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# How many similar-games hops from a user request the catalog may grow
SIMILAR_GAMES_MAX_DEPTH=1

# Web: URL the browser uses to reach the API
PUBLIC_API_URL=http://localhost:3030
