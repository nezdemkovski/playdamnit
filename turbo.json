{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV"
  ],
  "tasks": {
    "generate": {
      "inputs": [
        "$TURBO_DEFAULT$"
      ],
      "outputs": [
        "index.ts"
      ]
    },
    "build": {
      "dependsOn": [
        "^build",
        "generate"
      ],
      "env": [
        "NEXT_PUBLIC_*",
        "BACKEND_URL"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "*.js",
        "*.d.ts"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "TEST_POSTGRES_URL"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    }
  }
}
