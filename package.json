{
  "name": "playdamnit",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --env-mode=loose",
    "dev:backend": "turbo run dev --env-mode=loose --filter=@playdamnit/api --filter=@playdamnit/librarian",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "oxlint",
    "generate": "turbo run generate",
    "db:generate": "turbo run db:generate --env-mode=loose --filter=@playdamnit/db",
    "db:migrate": "turbo run db:migrate --env-mode=loose --filter=@playdamnit/db",
    "db:studio": "bun run --cwd packages/db db:studio",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "turbo": "^2.11.7"
  },
  "packageManager": "bun@1.4.2"
}
