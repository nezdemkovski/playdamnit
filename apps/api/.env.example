NODE_ENV=development
PORT=3030
# Matches docker-compose.dev.yml (`bun run db:up`)
POSTGRES_URL=postgresql://playdamnit:playdamnit@localhost:5432/playdamnit

# Required in production, optional in development
BETTER_AUTH_SECRET=
# Public URL of the API (callback links, passkey relying party); defaults to http://localhost:3030 in development
BETTER_AUTH_URL=
# Optional: without it sign-up needs no email verification and password reset is off
RESEND_API_KEY=

TRUSTED_ORIGINS=http://localhost:3000
TRUST_PROXY=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
SENTRY_DSN=
# IGDB webhook receiver (POST /api/webhooks/igdb/...); same value as the librarian
IGDB_WEBHOOK_SECRET=
LOG_LEVEL=info

# Steam Web API key for the Steam library import (https://steamcommunity.com/dev/apikey); without it the import is off
STEAM_API_KEY=

# Sign in with Apple: the iOS app's bundle ID (native sign-in, no secret needed; this is the default)
APPLE_APP_BUNDLE_ID=cloud.nezdemkovski.playdamnit
# Optional, for the web's redirect flow: the Services ID and its client secret (JWT from the .p8 key)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Feedback delivery to the product team (server-side only)
LINEAR_API_KEY=
LINEAR_TEAM_ID=
LINEAR_PROJECT_ID=
